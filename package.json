{
  "name": "triagebox",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "VITE_BUILD_ID=polish3 tsc --noEmit && VITE_BUILD_ID=polish3 vite build",
    "audit:copy": "node scripts/copy-audit.mjs",
    "test:copy": "node scripts/copy-audit.mjs --check",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test:unit": "vitest run tests/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run test:copy && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.58.2",
    "@types/node": "22.15.30",
    "axe-core": "4.10.2",
    "eslint": "^9.39.1",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.54.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
